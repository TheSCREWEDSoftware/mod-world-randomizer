[worldserver]

########################################
# mod-world-randomizer configuration
########################################
#
# Everything is set up once at startup. Changes here need a worldserver restart.
# Nothing is written to the creature tables, so Randomizer.World.Enable = 0 brings the normal world back.

#
#    Randomizer.Enable
#        Description: Master switch for the whole module (world shuffle, stats era, hardcore, co-op).
#                     Each feature also has its own switch below.
#        Default:     1 - enabled
#                     0 - disabled

Randomizer.Enable = 1

#
#    Randomizer.Announce
#        Description: On login, tell the player this server runs the module, with a line for each feature
#                     that is on (world shuffle and seed, stats era and XP rate, hardcore, co-op).
#        Default:     1 - enabled
#                     0 - disabled

Randomizer.Announce = 1

#
#    Randomizer.World.Enable
#        Description: Shuffle the world: zones into brackets, creatures, dungeon levels, start zones.
#        Default:     0 - disabled
#                     1 - enabled

Randomizer.World.Enable = 0

#
#    Randomizer.Seed
#        Description: World seed. 0 = roll one on the first start and keep it (characters DB,
#                     `world_randomizer_state`); .randomizer reroll stores a new one.
#                     The same seed, brackets and scope give the same shuffle here and on the web map.
#        Default:     0

Randomizer.Seed = 0

#
#    Randomizer.Brackets
#        Description: The level brackets, lowest first: "min-max,min-max,...". Each zone's original range
#                     puts it in a "home" bracket (the one holding the middle of its range); the shuffle then
#                     hands the brackets out to random zones. Bracket 1 is where new characters start.
#        Example:     "1-7,7-15,16-24,25-34,35-44,45-53,54-60" (the Classic video's brackets)
#                     They are sorted lowest first, and should follow on from each other (a gap means those levels
#                     get no zone; the server log warns about it).
#        Default:     "1-10,11-20,21-30,31-40,41-50,51-60,61-70,71-80"

Randomizer.Brackets = "1-10,11-20,21-30,31-40,41-50,51-60,61-70,71-80"

#
#    Randomizer.Brackets.Balanced
#        Description: 0 = every bracket keeps as many zones as it had (the shuffle swaps zones around).
#                     1 = zones are spread evenly over the brackets.
#        Default:     0

Randomizer.Brackets.Balanced = 0

#
#    Randomizer.Brackets.Adjacent
#        Description: 1 = neighbouring zones get neighbouring brackets: the shuffle starts at a random zone and
#                     grows outwards through bordering zones (`world_randomizer_zone_link`), lowest bracket first,
#                     so you level across the map instead of jumping between a 1-10 and a 70-80 zone next door.
#                     Over 200 seeds, neighbours end up 0.4 brackets apart on average (2.7 when fully random).
#                     0 = fully random.
#        Default:     1

Randomizer.Brackets.Adjacent = 1

#
#    Randomizer.Brackets.FactionStarts
#        Description: Make sure the Alliance and the Horde each get one of their own zones in bracket 1, so new
#                     characters don't all start in contested zones. If a faction has none after the shuffle,
#                     its lowest zone swaps brackets with a contested bracket 1 zone. Without this, both factions
#                     get one in about 1 seed out of 8.
#        Default:     1

Randomizer.Brackets.FactionStarts = 1

#
#    Randomizer.Scope
#        Description: Which zones are shuffled together.
#        Default:     0 - the whole world (Elwynn might be 70-80, Icecrown 1-10)
#                     1 - within each continent
#                     2 - within each expansion

Randomizer.Scope = 0

#
#    Randomizer.Creatures.Replace
#        Description: Replace outdoor combat creatures with a random creature from the zone's new bracket.
#                     The pool is every hostile / neutral creature that spawns in the open world, sorted into
#                     brackets by its level, split into land / water and normal / elite.
#                     Never replaced: NPCs with flags (vendors, quest givers...), creatures friendly to either
#                     faction (guards, town folk), critters, triggers, vehicles, world bosses, creatures with a
#                     C++ script, and spawns with their own SmartAI script.
#        Default:     1

Randomizer.Creatures.Replace = 1

#
#    Randomizer.Creatures.SameEntrySameReplacement
#        Description: 1 = every spawn of the same creature in a zone becomes the same random creature
#                     (a pack of wolves becomes a pack of something else). 0 = every spawn rolls on its own.
#        Default:     1

Randomizer.Creatures.SameEntrySameReplacement = 1

#
#    Randomizer.Creatures.ReplaceElites
#    Randomizer.Creatures.ReplaceRares
#        Description: Also replace elites (with elites) / rares.
#        Default:     1 / 0

Randomizer.Creatures.ReplaceElites = 1
Randomizer.Creatures.ReplaceRares = 0

#
#    Randomizer.Creatures.KeepQuestCreatures
#        Description: Keep creatures that are quest kill targets, so quests stay doable.
#        Default:     1

Randomizer.Creatures.KeepQuestCreatures = 1

#
#    Randomizer.Creatures.ShiftKeptLevels
#        Description: Creatures that are kept move their level into the zone's new bracket.
#        Default:     1

Randomizer.Creatures.ShiftKeptLevels = 1

#
#    Randomizer.Creatures.ExcludeEntries
#        Description: Creature entries never replaced, comma separated.
#        Default:     ""

Randomizer.Creatures.ExcludeEntries = ""

#
#    Randomizer.Creatures.ComputeMissingZones
#        Description: Most rows of `creature` have zoneId 0. The first start works out their zones from the
#                     terrain (slow once) and saves them in `world_randomizer_spawn_zone`. You can also run
#                     the core once with Calculate.Creature.Zone.Area.Data = 1 instead.
#        Default:     1

Randomizer.Creatures.ComputeMissingZones = 1

#
#    Randomizer.Dungeons.Mode
#        Description: How dungeon and raid creatures follow the bracket their entrance zone landed in.
#                     The entrance zone comes from the area trigger that teleports into the instance;
#                     `world_randomizer_instance` sets it for city entrances (RFC, the Stockade, the Violet Hold).
#                     With the collective below active, mod-dynamic-scaling does this instead (and adds its
#                     Simple mode buff), whatever this is set to.
#        Default:     2 - scale to the group, inside the bracket: creatures move to the highest player's level but
#                         never leave the bracket (RFC in a 31-40 bracket scales between 31 and 40). Bosses stay
#                         above their trash. Levels are picked when creatures spawn.
#                     1 - fixed shift: every creature moves by as many levels as the entrance zone's bracket moved
#                     0 - unchanged

Randomizer.Dungeons.Mode = 2

#
#    Randomizer.Collective.DynamicScaling
#        Description: Work together with mod-dynamic-scaling. Only takes effect when that module is installed and
#                     enabled and its own switch DynamicScaling.Collective.WorldRandomizer is on too (and the world
#                     shuffle is on here). Then this module hands every dungeon's bracket (from its entrance zone)
#                     to mod-dynamic-scaling, which scales the dungeon in Simple mode inside that bracket: Ragefire
#                     Chasm in a 31-40 bracket scales between 31 and 40. This module stops shifting dungeon levels
#                     itself, and mod-dynamic-scaling leaves the open world to this module.
#        Default:     1 - enabled
#                     0 - disabled (the two modules ignore each other)

Randomizer.Collective.DynamicScaling = 1

#
#    Randomizer.PlayerStart.Enable
#        Description: New characters start at a graveyard in a random bracket 1 zone, with the hearthstone
#                     set there.
#        Default:     1

Randomizer.PlayerStart.Enable = 1

#
#    Randomizer.PlayerStart.FactionLock
#        Description: 1 = only zones of the player's own faction, then contested zones.
#                     0 = any bracket 1 zone with a graveyard the player may use.
#        Default:     1

Randomizer.PlayerStart.FactionLock = 1

#
#    Randomizer.PlayerStart.SkipDeathKnights
#        Description: Death Knights keep their normal Ebon Hold start.
#        Default:     1

Randomizer.PlayerStart.SkipDeathKnights = 1

#
#    Randomizer.Coop.Enable
#        Description: Co-op starts. One player types .coop create and gets a 6 letter code; friends type
#                     .coop join <code> and start in the same place (a random bracket 1 zone when the world
#                     shuffle is on), with their hearthstone there and in the leader's group.
#        Default:     1

Randomizer.Coop.Enable = 1

#
#    Randomizer.Coop.MaxSize
#        Description: Players per co-op code, the leader included.
#        Default:     5

Randomizer.Coop.MaxSize = 5

#
#    Randomizer.Coop.MaxLevel
#        Description: Highest level at which a player may create or join a co-op party.
#        Default:     1

Randomizer.Coop.MaxLevel = 1

#
#    Randomizer.Coop.SameFaction
#        Description: Only players of the leader's faction may join.
#        Default:     1

Randomizer.Coop.SameFaction = 1

#
#    Randomizer.Coop.AutoGroup
#        Description: Joining puts the player in the leader's group when the leader is online.
#        Default:     1

Randomizer.Coop.AutoGroup = 1

#
#    Randomizer.Hardcore.Mode
#        Description: One life. A hardcore character that dies is never deleted for good: it is kept in the
#                     characters DB and listed in `world_randomizer_hardcore` with its owner account and how it
#                     died. A GM can undo a bugged death with .hardcore restore <name or GUID> [reason].
#                     Works with Randomizer.World.Enable = 0 too.
#        Default:     0 - off
#                     1 - players choose: .hardcore on confirm (only up to OptInMaxLevel, can't be undone)
#                     2 - every new character is hardcore

Randomizer.Hardcore.Mode = 0

#
#    Randomizer.Hardcore.OnDeath
#        Description: What happens to a hardcore character that dies.
#        Default:     2 - soft deleted: the core's own unlink (name and account move to deleteInfos_*,
#                         everything else stays). .hardcore restore or .character deleted restore bring it back.
#                     1 - locked: kicked now and on every login, stays on the account
#                     0 - ghost forever: can log in and walk around, can't be resurrected

Randomizer.Hardcore.OnDeath = 2

#
#    Randomizer.Hardcore.OptInMaxLevel
#        Description: Highest level at which .hardcore on is still allowed (Mode 1).
#        Default:     1

Randomizer.Hardcore.OptInMaxLevel = 1

#
#    Randomizer.Hardcore.KickDelay
#        Description: Seconds between the death and the kick (OnDeath 1 and 2), to see what happened.
#        Default:     10

Randomizer.Hardcore.KickDelay = 10

#
#    Randomizer.Hardcore.IgnoreBattlegrounds
#        Description: Deaths in battlegrounds and arenas don't count.
#        Default:     1

Randomizer.Hardcore.IgnoreBattlegrounds = 1

#
#    Randomizer.Hardcore.CountPvPDeaths
#        Description: Deaths to other players (outside battlegrounds) count.
#        Default:     1

Randomizer.Hardcore.CountPvPDeaths = 1

#
#    Randomizer.Hardcore.Announce
#        Description: Tell the whole server when someone starts a hardcore run, falls, or is restored.
#        Default:     1

Randomizer.Hardcore.Announce = 1

#
#    Randomizer.Stats.Era
#        Description: Player base stats (Str, Agi, Sta, Int, Spi, base health and mana) per level.
#                     Works with Randomizer.World.Enable = 0 too.
#        Default:     0 - unchanged (AzerothCore, normal XP)
#                     1 - Vanilla (vMaNGOS)       levels 1-60, then AzerothCore's growth
#                     2 - TBC     (cMaNGOS-TBC)   levels 1-70, then AzerothCore's growth
#                     3 - Wrath   (AzerothCore)   same stats as 0, but the Wrath XP rate below

Randomizer.Stats.Era = 0

#
#    Randomizer.Stats.XPRate.Vanilla
#    Randomizer.Stats.XPRate.TBC
#    Randomizer.Stats.XPRate.Wrath
#        Description: XP multiplier for the chosen era (all XP: kills, quests, exploration).
#                     Stacks with the core Rate.XP.* settings.
#        Default:     1.0 / 0.75 / 0.5

Randomizer.Stats.XPRate.Vanilla = 1.0
Randomizer.Stats.XPRate.TBC = 0.75
Randomizer.Stats.XPRate.Wrath = 0.5
